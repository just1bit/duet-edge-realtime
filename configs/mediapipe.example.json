{
  "backend": "cuda",
  "paths": {
    "duet_edge_root": "../duet-edge",
    "checkpoint": "../data+checkpoint/train-1800.pt",
    "input_motion": "",
    "mediapipe_model": "../data+checkpoint/pose_landmarker_full.task",
    "output_dir": "outputs",
    "root_scaled": false
  },
  "input": {
    "mode": "mediapipe",
    "timeline_id": "mediapipe-camera-0",
    "start_frame": 0,
    "end_frame": null,
    "transition_frames": 0,
    "camera_index": 0,
    "camera_width": 1280,
    "camera_height": 720,
    "maximum_missing_s": 0.5
  },
  "model": {
    "guidance_music": 0.0,
    "guidance_lead": 2.0,
    "sampling_steps": 50,
    "eta": 1.0,
    "seed": 1234
  },
  "continuity": {
    "causal_overlap": true,
    "relative_root_correction": true,
    "robust_filter_z": 6.0,
    "relative_root_soft_knee": 0.8,
    "relative_root_softness": 0.2,
    "diagnostic_sample_limit": 32
  },
  "stream": {
    "fps": 30,
    "window_frames": 150,
    "hop_frames": 75,
    "playout_delay_s": 0.75,
    "inference_queue_size": 1,
    "output_queue_size": 2,
    "viewer_queue_frames": 60,
    "inference_queue_policy": "block",
    "inference_slo_ms": 650.0,
    "safety_margin_ms": 50.0,
    "deadline_miss_policy": "continue",
    "jitter_slo_ms": 10.0
  },
  "server": {
    "bind_host": "127.0.0.1",
    "port": 8765,
    "web_port": 8080,
    "control_port": 8766,
    "web_root": "web"
  }
}
